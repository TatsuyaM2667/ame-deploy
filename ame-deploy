#!/bin/sh
SELF="$(readlink -f "$0")"
DEPLOY_DIR="$(dirname "$SELF")"

for _f in "$DEPLOY_DIR"/lib/*.sh; do
    [ -f "$_f" ] && . "$_f"
done

command -v log_info >/dev/null 2>&1 || log_info() { echo "[INFO] $*"; }
command -v log_ok   >/dev/null 2>&1 || log_ok()   { echo "[ OK ] $*"; }
command -v log_warn >/dev/null 2>&1 || log_warn() { echo "[WARN] $*" >&2; }
command -v log_err  >/dev/null 2>&1 || log_err()  { echo "[ERR ] $*" >&2; }
command -v pause    >/dev/null 2>&1 || pause()    { printf "\n  Enter > "; read _; }

DEV=""; P1=""; P2=""; TARGET=""; ESP=""

# target が既にマウント済みか自動検出
auto_detect_target() {
    if mountpoint -q /mnt/ame-target 2>/dev/null; then
        TARGET=/mnt/ame-target; ESP=/mnt/ame-esp
        [ -b /dev/sda2 ] && P2=/dev/sda2 && P1=/dev/sda1 && DEV=/dev/sda
        [ -b /dev/nvme0n1p2 ] && P2=/dev/nvme0n1p2 && P1=/dev/nvme0n1p1 && DEV=/dev/nvme0n1
        state_init
        return 0
    fi
    return 1
}

banner() {
    clear
    cat << 'BEOF'
+------------------------------------------------------+
|   Ame Linux Installer (ame-deploy) v0.7              |
|   idempotent / auto-repair / resume-capable          |
+------------------------------------------------------+
|   [1] Detect hardware                                |
|   [2] Select disk + partition                        |
|   [3] Copy rootfs                                    |
|   [4] Install kernel (linux-lts / edge)              |
|   [5] Install firmware / drivers                     |
|   [6] Select desktop environment (Hyprland)          |
|   [7] Create user                                    |
|   [8] Install bootloader                             |
|   [9] Verify install                                 |
|                                                      |
|   [R] Rescue (fix broken install)                    |
|   [A] Full auto (1-9, idempotent)                    |
|   [C] Show progress (state)                          |
|   [S] Shell    [X] Reboot  [P] Poweroff  [Q] Quit    |
+------------------------------------------------------+
BEOF
}

show_progress() {
    auto_detect_target 2>/dev/null || true
    echo
    echo "  === Progress state ==="
    if [ -n "$STATE_DIR" ] && [ -d "$STATE_DIR" ]; then
        state_list
    else
        echo "  (no state - install not started)"
    fi
    pause
}

step1() { show_hw_summary; pause; }
step2() {
    select_disk || return
    umount_disk
    partition_disk    || { log_err "partition failed"; pause; return; }
    format_partitions || { log_err "format failed"; pause; return; }
    mount_target      || { log_err "mount failed"; pause; return; }
    state_init
    state_clear
    log_ok "ready: $DEV ($P1, $P2)"
    pause
}
step3() {
    require_disk || { pause; return; }
    state_init
    if state_done "rootfs"; then
        log_info "rootfs already copied - skip"
        pause; return
    fi
    copy_rootfs; setup_target_skeleton; write_fstab
    state_mark "rootfs"
    log_ok "rootfs copied"
    pause
}
step4() {
    require_disk || { pause; return; }
    state_init
    select_and_install_kernel
    pause
}
step5() {
    require_disk || { pause; return; }
    state_init
    install_hw_firmware "$(detect_gpu)" "$(detect_wifi)"
    pause
}
step6() {
    require_disk || { pause; return; }
    state_init

    if ! state_done "kernel" || [ ! -d "$TARGET/lib/modules" ] || [ -z "$(ls -A "$TARGET/lib/modules" 2>/dev/null)" ]; then
        log_warn "kernel not installed - installing linux-lts first"
        select_and_install_kernel || { log_err "kernel failed"; pause; return; }
    fi

    echo
    echo "  Profile:"
    echo "    [0] minimal (CUI only)"
    echo "    [1] River"
    echo "    [2] KDE Plasma"
    echo "    [3] GNOME"
    echo "    [4] Hyprland (edge, auto-repair)"
    echo "    [5] Sway"
    printf "  Select [4]: "; read d
    [ -z "$d" ] && d="4"

    case "$d" in
        0) profile="00-minimal" ;;
        1) profile="01-river" ;;
        2) profile="02-kde" ;;
        3) profile="03-gnome" ;;
        4) profile="04-hyprland" ;;
        5) profile="05-sway" ;;
        *) log_err "invalid"; pause; return ;;
    esac

    lock="auto"
    if [ "$profile" = "02-kde" ]; then lock="sddm"; fi
    if [ "$profile" = "03-gnome" ]; then lock="gdm"; fi

    install_de_profile "$profile" "$lock"
    pause
}
step7() {
    require_disk || { pause; return; }
    state_init
    create_user
    pause
}
step8() {
    require_disk || { pause; return; }
    state_init
    install_bootloader_complete "$DEPLOY_DIR/boot" || { log_err "bootloader failed"; pause; return; }
    cleanup_deploy
    sync
    log_ok "bootloader installed"
    pause
}
step9() {
    require_disk || { pause; return; }
    state_init
    verify_target
    pause
}
step_rescue() { rescue_installed_system; pause; }

step_all() {
    printf "  Full auto (idempotent, resume-capable)? [y/N] > "; read c
    [ "$c" = "y" ] || return

    show_hw_summary
    state_init

    # 各ステップを冪等に
    if ! state_done "rootfs"; then
        select_disk || return
        umount_disk
        partition_disk    || return
        format_partitions || return
        mount_target      || return
        state_clear; state_init
        copy_rootfs
        setup_target_skeleton
        write_fstab
        state_mark "rootfs"
    fi

    state_done "kernel" || { log_info "installing linux-lts (default)"; echo "1" | select_and_install_kernel; }
    state_done "firmware" || install_hw_firmware "$(detect_gpu)" "$(detect_wifi)"
    state_done "hyprland" || install_de_profile "04-hyprland" none
    state_done "user" || create_user
    state_done "bootloader" || install_bootloader_complete "$DEPLOY_DIR/boot"

    cleanup_deploy
    sync
    verify_target

    umount "$ESP" 2>/dev/null || true
    umount "$TARGET" 2>/dev/null || true
    printf "  Reboot now? [y/N] > "; read r
    [ "$r" = "y" ] && reboot
}

require_root

# 依存チェック
if [ -f "$DEPLOY_DIR/requirements.txt" ]; then
    _pkgs=$(grep -v '^#' "$DEPLOY_DIR/requirements.txt" | grep -v '^$' | tr '\n' ' ')
    _miss=""
    for p in $_pkgs; do
        apk info -e "$p" >/dev/null 2>&1 || _miss="$_miss $p"
    done
    [ -n "$_miss" ] && { log_info "installing deps:$_miss"; apk update >/dev/null 2>&1 || true; apk add --no-cache $_miss >/dev/null 2>&1 || true; }
fi

# 自動マウント検出（Resume 用）
auto_detect_target 2>/dev/null || true

while true; do
    banner
    printf "  Select > "; read c
    case "$c" in
        1) step1 ;;
        2) step2 ;;
        3) step3 ;;
        4) step4 ;;
        5) step5 ;;
        6) step6 ;;
        7) step7 ;;
        8) step8 ;;
        9) step9 ;;
        R|r) step_rescue ;;
        A|a) step_all ;;
        C|c) show_progress ;;
        S|s) /bin/sh ;;
        X|x) reboot ;;
        P|p) poweroff ;;
        Q|q) exit 0 ;;
    esac
done
