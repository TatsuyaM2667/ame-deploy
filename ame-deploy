#!/bin/sh
SELF="$(readlink -f "$0")"
DEPLOY_DIR="$(dirname "$SELF")"
for _f in "$DEPLOY_DIR"/lib/*.sh; do [ -f "$_f" ] && . "$_f"; done

DEV=""; P1=""; P2=""; TARGET=""; ESP=""; STATE_DIR=""

banner() {
    clear
    cat << 'B'
+------------------------------------------------------+
|   Ame Linux Installer (ame-deploy) v9.0.0            |
|   WiFi auto-init + DRM card0 fix + Sway wrapper      |
+------------------------------------------------------+
|   [1] Detect hardware                                |
|   [2] Select disk + partition                        |
|   [3] Copy rootfs                                    |
|   [4] Install kernel                                 |
|   [5] Install firmware / drivers                     |
|   [6] Select desktop environment                     |
|   [7] Create user                                    |
|   [8] Install bootloader                             |
|   [9] Verify install                                 |
|                                                      |
|   [A] FULL AUTO (1-9)                                |
|   [R] Rescue (fix everything)                        |
|   [C] Show progress                                  |
|   [S] Shell    [X] Reboot  [P] Poweroff  [Q] Quit    |
+------------------------------------------------------+
B
}

step1() { show_hw_summary; pause; }
step2() {
    select_disk || return
    umount_disk
    partition_disk || { log_err "partition failed"; pause; return; }
    format_partitions || { log_err "format failed"; pause; return; }
    mount_target || { log_err "mount failed"; pause; return; }
    state_init; state_clear; state_init
    log_ok "ready: $DEV ($P1, $P2)"
    pause
}
step3() {
    require_disk || { pause; return; }
    state_init
    state_done "rootfs" && { log_info "rootfs already copied"; pause; return; }
    copy_rootfs; setup_target_skeleton; write_fstab
    state_mark "rootfs"
    log_ok "rootfs copied"
    pause
}
step4() { require_disk || { pause; return; }; state_init; select_and_install_kernel; pause; }
step5() { require_disk || { pause; return; }; state_init; install_hw_firmware "$(detect_gpu)" "$(detect_wifi)"; pause; }
step6() {
    require_disk || { pause; return; }
    state_init
    if ! state_done "kernel"; then
        log_warn "kernel not installed"
        select_and_install_kernel || { pause; return; }
    fi
    echo "  Profile:"
    echo "    [1] Sway           (recommended, DRM wrapper)"
    echo "    [2] Hyprland"
    echo "    [3] River          (river-classic)"
    echo "    [4] GNOME"
    echo "    [5] KDE Plasma"
    echo "    [6] Niri"
    echo "    [7] Miracle-WM"
    echo "    [8] MARSWM         (Rust, X11)"
    echo "    [9] orilla         (Rust, River WM)"
    echo "    [0] minimal"
    printf "  Select [1]: "; read d
    [ -z "$d" ] && d="1"
    case "$d" in
        0) profile="00-minimal" ;;
        1) profile="03-sway" ;;
        2) profile="01-hyprland" ;;
        3) profile="02-river" ;;
        4) profile="04-gnome" ;;
        5) profile="05-kde" ;;
        6) profile="06-niri" ;;
        7) profile="07-miracle-wm" ;;
        8) profile="08-marswm" ;;
        9) profile="09-orilla" ;;
        *) log_err "invalid"; pause; return ;;
    esac
    install_de_profile "$profile"
    pause
}
step7() { require_disk || { pause; return; }; state_init; create_user; pause; }
step8() {
    require_disk || { pause; return; }
    state_init
    install_bootloader_complete "$DEPLOY_DIR/boot" || { log_err "bootloader failed"; pause; return; }
    cleanup_deploy
    sync
    log_ok "bootloader installed"
    pause
}
step9() { require_disk || { pause; return; }; state_init; verify_target; pause; }
step_rescue() { rescue_installed_system; pause; }
step_progress() { auto_mount_target 2>/dev/null || true; echo "=== State ==="; state_list; pause; }

step_all() {
    printf "  FULL AUTO (Sway default)? [y/N] > "; read c
    [ "$c" = "y" ] || return
    show_hw_summary
    state_init
    if ! state_done "rootfs"; then
        select_disk || return
        umount_disk
        partition_disk || return
        format_partitions || return
        mount_target || return
        state_clear; state_init
        copy_rootfs; setup_target_skeleton; write_fstab
        state_mark "rootfs"
    fi
    state_done "kernel" || { echo "1" | { read _; select_and_install_kernel; }; }
    state_done "firmware" || install_hw_firmware "$(detect_gpu)" "$(detect_wifi)"
    state_done "de-sway" || install_de_profile "03-sway"
    state_done "user" || create_user
    state_done "bootloader" || install_bootloader_complete "$DEPLOY_DIR/boot"
    cleanup_deploy
    sync
    verify_target
    umount "$ESP" 2>/dev/null || true
    umount "$TARGET" 2>/dev/null || true
    printf "  Reboot now? [y/N] > "; read r
    [ "$r" = "y" ] && reboot
}

require_root

if [ -f "$DEPLOY_DIR/requirements.txt" ]; then
    _pkgs=$(grep -v '^#' "$DEPLOY_DIR/requirements.txt" | grep -v '^$' | tr '\n' ' ')
    _miss=""
    for p in $_pkgs; do apk info -e "$p" >/dev/null 2>&1 || _miss="$_miss $p"; done
    [ -n "$_miss" ] && { log_info "installing deps:$_miss"; apk update >/dev/null 2>&1 || true; apk add --no-cache $_miss >/dev/null 2>&1 || true; }
fi

auto_mount_target 2>/dev/null || true

while true; do
    banner
    printf "  Select > "; read c
    case "$c" in
        1) step1 ;;
        2) step2 ;;
        3) step3 ;;
        4) step4 ;;
        5) step5 ;;
        6) step6 ;;
        7) step7 ;;
        8) step8 ;;
        9) step9 ;;
        A|a) step_all ;;
        R|r) step_rescue ;;
        C|c) step_progress ;;
        S|s) /bin/sh ;;
        X|x) reboot ;;
        P|p) poweroff ;;
        Q|q) exit 0 ;;
    esac
done
