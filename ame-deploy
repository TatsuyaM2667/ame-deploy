#!/bin/sh
SELF="$(readlink -f "$0")"
DEPLOY_DIR="$(dirname "$SELF")"
for _f in "$DEPLOY_DIR"/lib/*.sh; do [ -f "$_f" ] && . "$_f"; done
command -v log_info >/dev/null 2>&1 || log_info() { echo "[INFO] $*"; }
command -v log_ok   >/dev/null 2>&1 || log_ok()   { echo "[ OK ] $*"; }
command -v log_warn >/dev/null 2>&1 || log_warn() { echo "[WARN] $*" >&2; }
command -v log_err  >/dev/null 2>&1 || log_err()  { echo "[ERR ] $*" >&2; }
command -v pause    >/dev/null 2>&1 || pause()    { printf "\n  Enter > "; read _; }

DEV=""; P1=""; P2=""; TARGET=""; ESP=""

auto_detect_target() {
    if mountpoint -q /mnt/ame-target 2>/dev/null; then
        TARGET=/mnt/ame-target; ESP=/mnt/ame-esp
        for d in sda nvme0n1 vda; do
            if [ -b "/dev/${d}2" ] || [ -b "/dev/${d}p2" ]; then
                DEV="/dev/$d"
                [ -b "/dev/${d}2" ]  && { P1="/dev/${d}1";  P2="/dev/${d}2";  }
                [ -b "/dev/${d}p2" ] && { P1="/dev/${d}p1"; P2="/dev/${d}p2"; }
                break
            fi
        done
        state_init
        return 0
    fi
    return 1
}

banner() {
    clear
    cat << 'BEOF'
+------------------------------------------------------+
|   Ame Linux Installer (ame-deploy) v1.0              |
|   FULL-AUTO / River default / 4-DE reliable          |
+------------------------------------------------------+
|   [1] Detect hardware                                |
|   [2] Select disk + partition                        |
|   [3] Copy rootfs                                    |
|   [4] Install kernel                                 |
|   [5] Install firmware / drivers                     |
|   [6] Select desktop environment                     |
|   [7] Create user                                    |
|   [8] Install bootloader                             |
|   [9] Verify install                                 |
|                                                      |
|   [A] ★ FULL AUTO (default: River, minimal prompts)  |
|   [R] Rescue                                         |
|   [C] Show progress                                  |
|   [S] Shell    [X] Reboot  [P] Poweroff  [Q] Quit    |
+------------------------------------------------------+
BEOF
}

show_progress() {
    auto_detect_target 2>/dev/null || true
    echo
    echo "  === Progress state ==="
    if [ -n "$STATE_DIR" ] && [ -d "$STATE_DIR" ]; then state_list; else echo "  (none)"; fi
    pause
}

step1() { show_hw_summary; pause; }
step2() {
    select_disk || return
    umount_disk
    partition_disk    || { log_err "partition failed"; pause; return; }
    format_partitions || { log_err "format failed"; pause; return; }
    mount_target      || { log_err "mount failed"; pause; return; }
    state_init; state_clear; state_init
    log_ok "ready: $DEV ($P1, $P2)"
    pause
}
step3() {
    require_disk || { pause; return; }
    state_init
    state_done "rootfs" && { log_info "rootfs copied - skip"; pause; return; }
    copy_rootfs; setup_target_skeleton; write_fstab
    state_mark "rootfs"
    pause
}
step4() { require_disk || { pause; return; }; state_init; select_and_install_kernel; pause; }
step5() { require_disk || { pause; return; }; state_init; install_hw_firmware "$(detect_gpu)" "$(detect_wifi)"; pause; }
step6() {
    require_disk || { pause; return; }
    state_init
    if ! state_done "kernel" || [ ! -d "$TARGET/lib/modules" ] || [ -z "$(ls -A "$TARGET/lib/modules" 2>/dev/null)" ]; then
        log_warn "kernel missing - installing linux-lts"
        select_and_install_kernel || { log_err "kernel failed"; pause; return; }
    fi
    echo
    echo "  Profile:"
    echo "    [1] River          (default, wayland tiling)"
    echo "    [2] KDE Plasma"
    echo "    [3] GNOME"
    echo "    [4] Hyprland       (edge, best-effort)"
    echo "    [5] Sway"
    echo "    [0] minimal"
    printf "  Select [1]: "; read d
    [ -z "$d" ] && d="1"
    case "$d" in
        0) profile="00-minimal" ;;
        1) profile="01-river" ;;
        2) profile="02-kde" ;;
        3) profile="03-gnome" ;;
        4) profile="04-hyprland" ;;
        5) profile="05-sway" ;;
        *) log_err "invalid"; pause; return ;;
    esac
    install_de_profile "$profile"
    pause
}
step7() { require_disk || { pause; return; }; state_init; create_user; pause; }
step8() {
    require_disk || { pause; return; }
    state_init
    install_bootloader_complete "$DEPLOY_DIR/boot" || { log_err "bootloader failed"; pause; return; }
    cleanup_deploy
    sync
    pause
}
step9() { require_disk || { pause; return; }; state_init; verify_target; pause; }
step_rescue() { rescue_installed_system; pause; }

# ---- FULL AUTO ----
step_full_auto() {
    AUTOMODE=1

    echo
    echo "======================================================"
    echo "   FULL AUTO INSTALL"
    echo "   - kernel : linux-lts"
    echo "   - DE     : River (default)"
    echo "   - user   : ame / ame / ame"
    echo "======================================================"
    echo
    echo "  !! This will WIPE the selected disk !!"
    echo
    printf "  Continue? type 'yes' > "; read c
    [ "$c" = "yes" ] || return

    show_hw_summary

    # --- [2] disk ---
    select_disk || return
    umount_disk
    partition_disk    || { log_err "partition failed"; return; }
    format_partitions || { log_err "format failed"; return; }
    mount_target      || { log_err "mount failed"; return; }
    state_init; state_clear; state_init
    state_mark "rootfs-begin"

    # --- [3] rootfs ---
    log_info "[3/9] rootfs copy"
    copy_rootfs
    setup_target_skeleton
    write_fstab
    state_mark "rootfs"

    # --- [4] kernel ---
    log_info "[4/9] kernel (linux-lts)"
    select_and_install_kernel || return
    state_mark "kernel"

    # --- [5] firmware ---
    log_info "[5/9] firmware"
    install_hw_firmware "$(detect_gpu)" "$(detect_wifi)"
    state_mark "firmware"

    # --- [6] DE (River default) ---
    log_info "[6/9] Desktop (River)"
    install_de_profile "01-river"
    state_mark "de"

    # --- [7] user ---
    log_info "[7/9] user"
    create_user
    state_mark "user"

    # --- [8] bootloader ---
    log_info "[8/9] bootloader"
    install_bootloader_complete "$DEPLOY_DIR/boot" || return
    state_mark "bootloader"
    cleanup_deploy

    # --- [9] verify ---
    log_info "[9/9] verify"
    sync
    verify_target

    umount "$ESP"    2>/dev/null || true
    umount "$TARGET" 2>/dev/null || true

    echo
    log_ok "=========================================="
    log_ok " FULL AUTO INSTALL COMPLETE"
    log_ok "=========================================="
    echo "  user: ame / password: ame"
    echo "  root: ame"
    echo
    printf "  Reboot now? [y/N] > "; read r
    [ "$r" = "y" ] && reboot
}

require_root

if [ -f "$DEPLOY_DIR/requirements.txt" ]; then
    _pkgs=$(grep -v '^#' "$DEPLOY_DIR/requirements.txt" | grep -v '^$' | tr '\n' ' ')
    _miss=""
    for p in $_pkgs; do apk info -e "$p" >/dev/null 2>&1 || _miss="$_miss $p"; done
    [ -n "$_miss" ] && { log_info "installing deps:$_miss"; apk update >/dev/null 2>&1 || true; apk add --no-cache $_miss >/dev/null 2>&1 || true; }
fi

auto_detect_target 2>/dev/null || true

while true; do
    banner
    printf "  Select > "; read c
    case "$c" in
        1) step1 ;;
        2) step2 ;;
        3) step3 ;;
        4) step4 ;;
        5) step5 ;;
        6) step6 ;;
        7) step7 ;;
        8) step8 ;;
        9) step9 ;;
        A|a) step_full_auto ;;
        R|r) step_rescue ;;
        C|c) show_progress ;;
        S|s) /bin/sh ;;
        X|x) reboot ;;
        P|p) poweroff ;;
        Q|q) exit 0 ;;
    esac
done
